# Solana RPC the app reads from and submits to.
EXPO_PUBLIC_RPC_URL=http://127.0.0.1:8899
# MWA chain id used when authorizing with the wallet: solana:devnet | solana:mainnet
EXPO_PUBLIC_SOLANA_CHAIN=solana:devnet
# "wallet": wallet signs and sends (devnet/mainnet). "app": wallet signs, app submits (localnet dev).
EXPO_PUBLIC_TX_SUBMIT=app
# bulbul server (attestor, metadata).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Identity the wallet shows when connecting (our deep-link scheme until there is a domain).
EXPO_PUBLIC_APP_URL=bulbul://app

{
  "name": "@bulbul/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check-art": "tsx src/check-art.ts",
    "localnet": "tsx --env-file=.env.localnet src/index.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "faucet": "tsx scripts/faucet.ts",
    "inspect": "tsx scripts/inspect.ts",
    "devnet": "tsx --env-file=.env.devnet src/index.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@hono/node-server": "^2.1.3",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.0.3",
    "bs58": "^6.0.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "bigint-buffer": false,
    "bufferutil": false,
    "utf-8-validate": false
  }
}
